# ══════════════════════════════════════════
#   SIBERI.AI — Production Environment
#   Скопируйте в .env и заполните значения
# ══════════════════════════════════════════

NODE_ENV=production
PORT=3000

# ── MongoDB ───────────────────────────────
# Локальная MongoDB (рекомендуется для начала)
MONGO_URI=mongodb://localhost:27017/siberiai_api
# Или MongoDB Atlas:
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/siberiai_api

# ── URLs (замените на ваш домен) ─────────
FRONTEND_URL=https://yourdomain.com
SERVER_URL=https://yourdomain.com
APP_URL=https://yourdomain.com
# SERVER_URL нужен для webhook callback (Telegram/VK) — должен быть публично доступен
# APP_URL используется в email-письмах (ссылки на сайт)

# ── Email (SMTP) ──────────────────────────
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Siberi.AI <noreply@yourdomain.com>"

# ── Google OAuth & Sheets ─────────────────
GOOGLE_API_KEY=AIza...
# Google OAuth Login (console.cloud.google.com → Credentials → OAuth 2.0)
# Authorized redirect URI: https://yourdomain.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Yandex OAuth ──────────────────────────
# oauth.yandex.ru → Создать приложение → Web-сервисы
# Callback URL: https://yourdomain.com/api/v1/auth/yandex/callback
YANDEX_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
YANDEX_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── VK OAuth ──────────────────────────────
# vk.com/editapp → Создать приложение → Веб-сайт
# Authorized redirect URI: https://yourdomain.com/api/v1/auth/vk/callback
VK_CLIENT_ID=xxxxxxx
VK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Secrets (генерируйте случайные строки) ─
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=replace_with_random_64char_hex
OAUTH_STATE_SECRET=replace_with_random_32char_hex

# ── AI Demo ───────────────────────────────
# Chat ID для демо-страницы лендинга (без авторизации)
DEMO_CHAT_ID=your_mistral_chat_id_for_demo

# ── Playwright / Browser ──────────────────
# Принудительно использовать Qwen (если Mistral недоступен)
FORCE_QWEN=false

# ── Оплата (YooMoney) ────────────────────
# Номер кошелька YooMoney (получить на yoomoney.ru → Настройки → Данные кошелька)
YOOMONEY_WALLET=4100118xxxxxxxxx
# Секрет для проверки подписи webhook (задаётся в настройках YooMoney → HTTP-уведомления → Секрет)
YOOMONEY_WEBHOOK_SECRET=replace_with_your_yoomoney_secret

# Откликс (hhpilot) временно использует этот же кошелёк — ЮMoney шлёт уведомление
# только сюда, поэтому платежи Откликс (label вида <tenantId>_weekly|monthly_<ts>)
# распознаются и форвардятся дальше, в core-api Откликс (см. server/routes/payment.js,
# forwardToOtkliks). Публичный URL core-api Откликс, например https://api.otkliks.ru —
# пусто = форвардинг отключён, платёж просто залогируется как «переслать некуда».
OTKLIKS_CORE_API_URL=

# ── НЕ ДОБАВЛЯТЬ В ПРОДАКШЕН ─────────────
# DEV_SECRET — только для разработки, не нужен в prod
# DEV_EMAIL — bypass авторизации, только для dev
